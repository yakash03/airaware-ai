# AirAware AI V2 — Environment Configuration Template
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit actual API keys or secrets to version control.

# Google Gemini API Key (Server-side only)
# Required for real-time generative AI explanations and conversational assistant.
# If omitted, AirAware AI operates seamlessly using its built-in deterministic rule engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Open-Meteo Air Quality & Weather API Endpoints (Free, no key required)
NEXT_PUBLIC_OPEN_METEO_AIR_URL=https://air-quality-api.open-meteo.com/v1/air-quality
NEXT_PUBLIC_OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
NEXT_PUBLIC_OPEN_METEO_GEO_URL=https://geocoding-api.open-meteo.com/v1/search

# Cache TTL Configuration (Milliseconds)
AIR_QUALITY_CACHE_TTL_MS=900000
WEATHER_CACHE_TTL_MS=900000
GEOCODING_CACHE_TTL_MS=86400000
